{
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/project-neighbourhood-coffee-bar-the-hague.html",
      "destination": "/project-oak-kitchen-family-home.html",
      "permanent": true
    },
    {
      "source": "/project-city-apartment-valencia.html",
      "destination": "/project-family-townhouse-the-hague.html",
      "permanent": true
    },
    {
      "source": "/project-family-townhouse.html",
      "destination": "/project-family-townhouse-the-hague.html",
      "permanent": true
    }
  ]
}